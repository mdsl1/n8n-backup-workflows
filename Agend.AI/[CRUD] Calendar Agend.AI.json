      "name": "[SET] Dados Evento",
      "parameters": {
        "jsCode": "const payload = $(\"[CRUD] Agend.AI\").first().json.body;\n\nconst dadosEvento = payload.evento;\nconst dadosProfissional = payload.profissional;\nconst dadosCliente = payload.cliente;\n\nconst titulo = `${dadosCliente.nome} - ${dadosProfissional.procedimento}`;\nconst descricao = dadosEvento.motivo_contato;\nconst event_id = `ag${dadosEvento.uuid.replace(/-/g, \"\")}`;\n\nreturn [{\n  json: {\n    id_agendamento: dadosEvento.uuid,\n    id_calendar: dadosProfissional.id_calendar,\n    event_id: event_id,\n    titulo: titulo,\n    descricao: descricao,\n    inicio: dadosEvento.hora_inicio,\n    fim: dadosEvento.hora_fim\n  }\n}];\n"
      },
