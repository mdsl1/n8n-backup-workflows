    {
      "id": "504c16ea-65b3-45d2-a5c4-af236b1036ce",
      "name": "[SET] Dados Agenda",
      "parameters": {
        "jsCode": "const payload = $(\"[CRUD] Agend.AI\").first().json.body;\nconst nome = payload.nome;\nconst partesNome = nome.trim().split(\" \");\nconst timezone = payload.timezone;\n\nlet nome_agenda = \"\";\nlet prefixo = \"\";\n\nconst response = await this.helpers.httpRequest({\n  method: \"GET\",\n  url: `https://api.genderize.io?name=${partesNome[0]}`,\n  json: true\n});\n\nif(response.probability > 0.9) {\n  prefixo = (response.gender === \"male\") ? \"Dr.\" : \"Dra.\"\n}\nelse {\n  prefixo = \"Dr(a).\"\n}\n\nif(partesNome.length > 2) {\n  nome_agenda = `${prefixo} ${partesNome[0]} ${partesNome[1][0].toUpperCase()} ${partesNome.at(-1) }`;\n}\nelse {\n  nome_agenda = `${prefixo} ${nome}`;\n}\n\nreturn [{\n  json: {\n    prefixo: prefixo,\n    nome_completo: nome,\n    nome_agenda: nome_agenda,\n    timezone: timezone,\n  }\n}];"
      },
      "position": [
        -688,
        -1632
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
