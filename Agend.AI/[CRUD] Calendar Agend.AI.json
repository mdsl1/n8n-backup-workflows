    {
      "id": "d6c18957-3fbb-41ab-bc2e-d8536500c618",
      "name": "[SET] Response2",
      "parameters": {
        "jsCode": "const data = $(\"[GET] Consultar eventos by Agenda\").all();\nconst profissionalUuid = $('[SET] Dados Busca Agenda').first().json.profissional_uuid;\nconst events = [];\n\nfor (const item of data) {\n  const event = item.json;\n  const id = event.id;\n  const cliente = event.summary.split(\" - \")[0];\n  const procedimento = event.summary.split(\" - \")[1];\n  const inicio = event.start?.dateTime; // Vem no formato 2026-08-07T18:00:00Z, com o timezone America/Sao_Paulo. converter para -03:00\n  const fim = event.end?.dateTime;\n\n  events.push({\n    id: id,\n    title: cliente.trim() || null,\n    inicio: inicio,\n    fim: fim,\n    extendedProps: {\n      patient: cliente.trim() || null,\n      procedure: procedimento || null,\n      doctorUuid: profissionalUuid\n    }\n  })\n}\n\nreturn [\n  {\n    json: {\n      events\n    },\n  },\n];"
      },
      "position": [
        -528,
        -2128
      ],
      "type": "n8n-nodes-base.code",
