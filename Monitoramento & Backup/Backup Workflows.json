    {
      "id": "a58e94f4-48ca-4f8e-bd3a-283c5e925cab",
      "name": "Code in JavaScript",
      "parameters": {
        "jsCode": "// 1. Função auxiliar para ordenar as chaves do JSON de forma idêntica\nconst orderJsonKeys = (jsonObj) => {\n  if (typeof jsonObj !== 'object' || jsonObj === null) return jsonObj;\n  \n  // Se for um array (como a lista de nós), ordena as chaves de cada item de forma recursiva\n  if (Array.isArray(jsonObj)) {\n    return jsonObj.map(orderJsonKeys);\n  }\n\n  const ordered = {};\n  Object.keys(jsonObj).sort().forEach(key => {\n    ordered[key] = orderJsonKeys(jsonObj[key]);\n  });\n  return ordered;\n};\n\n// 2. Função para remover metadados que mudam sozinhos no n8n e quebram a comparação\nconst sanitizeWorkflow = (wf) => {\n  const clean = { ...wf };\n  delete clean.versionId;\n  delete clean.updatedAt;\n  delete clean.createdAt;\n  return clean;\n};\n\n// 3. Captura o workflow atual vindo do Loop (Dados do n8n)\nconst rawN8nWorkflow = $('Loop Over Items').item.json;\nconst n8nWorkflowClean = sanitizeWorkflow(rawN8nWorkflow);\nconst orderedActual = orderJsonKeys(n8nWorkflowClean);\n\n// 4. Captura a resposta do nó anterior (GET Arquivo do GitHub)\nconst githubResponse = $input.item.json;\n\n// 5. Variáveis de controle de caminhos (Tags)\nlet folderName = 'Sem-Pasta';\nif (rawN8nWorkflow.tags && rawN8nWorkflow.tags.length > 0) {\n  folderName = rawN8nWorkflow.tags[0].name.trim().replace(/[\\/\\\\?%*:|\"<>]/g, '-');\n}\nconst defaultPath = `${folderName}/${rawN8nWorkflow.name}.json`;\n\n// 6. EXECUÇÃO DA LÓGICA DE COMPARAÇÃO\nlet githubStatus = \"new\";\nlet filePath = defaultPath;\n\n// Se o arquivo existe no GitHub (contém a chave \"content\")\nif (githubResponse && githubResponse.content) {\n  try {\n    // Decodifica o Base64 do GitHub\n    const githubBase64 = githubResponse.content.replace(/\\s/g, '');\n    const githubTextContent = Buffer.from(githubBase64, 'base64').toString('utf-8');\n    const origWorkflow = JSON.parse(githubTextContent);\n    \n    // Limpa e ordena ambos para comparação justa\n    const orderedOriginal = orderJsonKeys(sanitizeWorkflow(origWorkflow));\n\n    // Determina se são estritamente iguais\n    if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n      githubStatus = \"do_nothing\"; // Totalmente igual\n    } else {\n      githubStatus = \"update\";     // Houve alteração real\n    }\n  } catch (e) {\n    githubStatus = \"update\"; // Se falhar na decodificação, força update por segurança\n  }\n  filePath = githubResponse.path || defaultPath;\n} \n\n// 7. Monta o payload final que será injetado no fluxo\nconst outputJson = {\n  ...rawN8nWorkflow, // Mantém os dados originais se precisar deles nos nós seguintes\n  github_status: githubStatus,\n  github_file_path: filePath,\n  formatted_content: JSON.stringify(orderedActual, null, 2) // Envia o JSON perfeitamente ordenado para o Git\n};\n\nreturn { json: outputJson };"
      },
