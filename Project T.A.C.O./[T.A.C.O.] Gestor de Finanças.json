    {
      "id": "93e20a14-1c11-4d07-a096-c8b0c8930957",
      "name": "Information Extractor",
      "parameters": {
        "attributes": {
          "attributes": [
            {
              "description": "=Tipo da operação financeira. Deve ser estritamente um dos seguintes valores: 'entrada' (salário, recebimentos), 'saida' (compras, pagamentos de contas, lanches, boletos) ou 'transferencia' (movimentação de dinheiro entre contas próprias ou aportes de reserva/investimento).",
              "name": "tipo_transacao",
              "required": true
            },
            {
              "description": "Método utilizado no pagamento ou movimentação. Deve ser estritamente um dos seguintes valores: 'pix', 'cartao_debito', 'cartao_credito', 'boleto' ou 'movimentacao_patrimonial' (usado exclusivamente quando tipo_transacao for transferencia). Se o usuário falar apenas 'crédito' ou 'débito', converta para 'cartao_credito' ou 'cartao_debito'.",
              "name": "metodo_pagamento",
              "required": true
            },
            {
              "description": "Valor numérico da transação em reais. Apenas o número decimal positivo (ex: 24.50, 15, 108.00). Não incluir símbolos de moeda como R$.",
              "name": "valor",
              "required": true,
              "type": "number"
            },
            {
              "description": "Nome do banco, carteira ou conta de onde o dinheiro saiu ou ao qual o cartão utilizado pertence. Exemplos comuns: 'Santander', '99Pay', 'Nubank', 'Caixinha Turbo', 'Rico'. Se for compra no crédito Santander, a origem é 'Santander'.",
              "name": "centro_custo_origem",
              "required": true
            },
            {
              "description": "Nome do banco ou conta de destino quando o usuário estiver transferindo dinheiro entre contas próprias ou fazendo aportes. Exemplo: 'Santander', 'Caixinha Turbo', 'Rico'. Deixe em branco/nulo se a transação for apenas uma entrada ou saída comum.",
              "name": "centro_custo_destino"
            },
            {
              "description": "Nome do cartão utilizado caso o metodo_pagamento seja 'cartao_credito' (ex: 'Santander SX'). Deixe em branco/nulo se a transação for no débito, pix, boleto ou transferência.",
              "name": "cartao_nome"
            },
            {
              "description": "Nome da categoria mais adequada para a despesa/receita: 'Comida' (lanches fora, restaurantes), 'Mercado' (supermercado, mantimentos), 'Transporte' (gasolina, moto, uber), 'Compras' (roupas, eletrônicos), 'Assinaturas de Serviços' (streaming, claro), 'Faturas / Contas' (água, luz, internet, quitação consolidada de cartão), 'Empréstimos' (parcelas de empréstimo), 'Transferências' (pix para terceiros), 'Diversos' (gastos pontuais/imprevistos), 'Investimentos' (aportes em reserva ou bolsa), ou 'Transferencia Interna' (quando tipo_transacao for transferencia entre contas próprias).",
              "name": "categoria_nome",
              "required": true
            },
            {
              "description": "Breve descrição do que foi comprado ou da movimentação realizada (ex: 'Pão de queijo na faculdade', 'Combustível pra moto', 'Aporte reserva', 'Salário quinzenal').",
              "name": "descricao",
              "required": true
            },
            {
              "description": "Mês e ano da fatura no formato 'YYYY-MM'. Preencher apenas se metodo_pagamento for 'cartao_credito'. Considere que o cartão fecha no dia 07 e vence no dia 14: se a compra ocorrer até o dia 07, entra na fatura do mês atual; se ocorrer após o dia 07, entra na fatura do mês seguinte. Se não for crédito, deixe em branco/nulo.",
              "name": "fatura_mes_ano"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "=Hoje é dia {{ $now.format('dd/mm/yyyy') }}\n"
        },
        "text": "={{ $json.prompt }}"
      },
