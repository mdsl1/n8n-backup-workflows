    {
      "id": "df87fd42-165b-4a93-8f15-8d42339437c5",
      "name": "Code in JavaScript",
      "parameters": {
        "jsCode": "// 1. Acesso aos dados\nconst saldosAtuais = $input.first().json; \nconst transacao = $('Information Extractor').first().json.output;\nconst valorLimpo = parseFloat(transacao.valor || 0);\n\nconst tipo = transacao.tipo_transacao;\nconst is_credito = transacao.tipo_valor === \"Cartão Crédito\";\nconst bancoOrigem = transacao.centro_de_custo; \nconst descricao = transacao.descricao || \"\";\n\n// 3. Mapeamento de colunas\nconst getColuna = (nome) => {\n    const mapa = {\n        \"Santander\": \"Saldo Santander\",\n        \"Nubank\": \"Saldo Nubank\",\n        \"Itaú\": \"Saldo Itaú\",\n        \"99Pay\": \"Saldo 99Pay\",\n        \"Rico\": \"Investimentos Rico\",\n        \"Caixinha\": \"Caixinha Nubank\",\n        \"Poupança\": \"Poupança Santander\"\n    };\n    return mapa[nome] || nome;\n};\n\nconsole.log(\"DADOS CAPTURADOS:\", { bancoOrigem, tipo, valorLimpo, is_credito });\n\n// 4. Lógica de Cálculo\ntry {\n    if (tipo === \"Movimentação\") {\n        const bancos = [\"Santander\", \"Nubank\", \"Itaú\", \"99Pay\", \"Rico\", \"Caixinha\", \"Poupança\"];\n        let bancoDestino = bancos.find(b => {\n            const descricaoSemAcento = descricao.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLowerCase();\n            const bancoSemAcento = b.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLowerCase();\n            \n            return descricaoSemAcento.includes(bancoSemAcento) && b !== bancoOrigem;\n        });\n\n      console.log(`Banco Origem: ${bancoOrigem}, Banco Destino: ${bancoDestino}`);\n        if (bancoOrigem && bancoDestino) {\n            const colOrigem = getColuna(bancoOrigem);\n            const colDestino = getColuna(bancoDestino);\n            \n            saldosAtuais[colOrigem] = parseFloat((Number(saldosAtuais[colOrigem] || 0) - valorLimpo).toFixed(2));\n            saldosAtuais[colDestino] = parseFloat((Number(saldosAtuais[colDestino] || 0) + valorLimpo).toFixed(2));\n        }\n    } else if (!is_credito) {\n        const coluna = getColuna(bancoOrigem);\n        \n        // Log de debug para você ver no console do navegador se quiser\n        console.log(`Calculando: ${coluna}, Tipo: ${tipo}, Valor: ${valorLimpo}`);\n\n        if (saldosAtuais.hasOwnProperty(coluna)) {\n            const saldoAtualNum = Number(saldosAtuais[coluna] || 0);\n            saldosAtuais[coluna] = (tipo === \"Entrada\") ? saldoAtualNum + valorLimpo : saldoAtualNum - valorLimpo;\n        }\n    }\n} catch (e) {\n    throw new Error(\"Erro no processamento: \" + e.message);\n}\n\n// 5. Retorna o objeto\nreturn { json: saldosAtuais };"
      },
