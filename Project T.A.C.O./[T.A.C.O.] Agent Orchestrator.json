        "name": "Conversão de mimeType",
        "parameters": {
          "jsCode": "// Acessa todos os itens da entrada\nconst allItems = $input.all();\n\nfor (let item of allItems) {\n  // Verifica se o item possui dados binários\n  if (item.binary && item.binary.data) {\n    // Sobrescreve os metadados para \"enganar\" a API do Groq\n    item.binary.data.fileName = 'audio.mp3';\n    item.binary.data.mimeType = 'audio/mpeg';\n    item.binary.data.fileExtension = 'mp3';\n  }\n}\n\nreturn allItems;"
        },
